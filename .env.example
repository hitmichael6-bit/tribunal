# Copy to .env and fill in. Never commit the real .env file.

# --- OpenRouter ---
OPENROUTER_API_KEY=

# Optional, sent to OpenRouter as attribution headers. Fine to leave unset.
PUBLIC_SITE_URL=

# Optional. Overall wall-clock budget (ms) for a single agent's OpenRouter
# call, across all retry attempts and the response body download. Unset =
# 25000. Keep it below the function timeout (30s local; Netlify's
# synchronous ceiling in production) so a slow model fails as a visible
# failure card rather than an opaque 502. Lower it for a fast model, raise
# it only if your function timeout is higher.
OPENROUTER_TIMEOUT_MS=

# Default model for all 7 agents. Free NVIDIA model with a 1M context window
# as of Aug 2026 — swap for anything else on https://openrouter.ai/models.
DEFAULT_MODEL=nvidia/nemotron-3.5-lightning:free

# Optional per-role overrides. Unset = falls back to DEFAULT_MODEL.
MODEL_JON_SNOW=
MODEL_TYRION=
MODEL_DAENERYS=
MODEL_GREY_WORM=
MODEL_JUDGE_BARAK=
MODEL_JUDGE_ELON=
MODEL_JUDGE_SHAMGAR=

# --- API access gate (optional) ---
# Shared secret the 4 function endpoints require as an X-Tribunal-Key header.
# Empty = gate off (any request accepted) — fine for local dev. Set it on a
# public deployment to a long random string (e.g. `openssl rand -hex 24`) so
# blind bots hitting the function URLs get a 401 instead of spending credit.
# NOT a real secret: the frontend ships the same value in its bundle. Real
# spend protection is the credit limit on the OpenRouter key. The VITE_
# prefix is required — it's what exposes the value to the frontend build.
VITE_TRIBUNAL_ACCESS_KEY=

# --- Supabase ---
# Service-role key only — this is a backend secret and must never be exposed
# to the frontend build. The browser never talks to Supabase directly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
